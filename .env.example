# Copy to .env and fill in with values from YOUR OWN dedicated, non-production
# Entra ID test tenant. Never commit .env — it's already git-ignored.
# See docs/entra-setup.md for what to register and the minimum Graph permission.

# --- Keycloak / LocalStack (default path, no change) ---
# 8180, not 8080: docker-compose.override.yml remaps the host port to avoid
# a local port conflict (docker-compose.yml itself still publishes 8080).
KEYCLOAK_URL=http://localhost:8180
AWS_ENDPOINT_URL=http://localhost:4566

# --- Entra ID (bridgelab-attack --idp entra) ---
# App registration representing the agent's own identity.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Azure, --technique additional-credentials (default) ---
# Object ID of the target Application the agent will "escalate" into
# (add a client secret to). Must be a throwaway app created solely to be
# the victim in this demo — never a real production app registration.
AZURE_TARGET_APP_ID=

# --- Azure, --technique additional-roles ---
# bridgelab-agent's own Service Principal object ID (Enterprise applications
# blade, not App registrations) — same value you already looked up via
# `az ad sp show` to link ownership above. Real Azure runs of this technique
# are read-only only (see docs/entra-setup.md), so this is only ever used to
# list current role assignments, never to grant one.
ENTRA_AGENT_SP_OBJECT_ID=

# --- Azure, --technique out-of-scope-access ---
# Any principal (user, group, or service principal) object ID in your test
# tenant OTHER than bridgelab-agent's own SP above — the point is that the
# agent's token is reused to query a directory principal outside its
# declared tool list. Read-only only, same RoleManagement.Read.Directory
# permission already granted for additional-roles above — no new consent
# needed.
ENTRA_OUT_OF_SCOPE_PRINCIPAL_ID=

# --- Azure, --technique data-collection ---
# Storage account and container the agent's SP has been granted Storage
# Blob Data Reader on (see docs/entra-setup.md). Unlike the two Graph-based
# techniques above, this one runs fully live, not read-only-capped — the
# permission is container-scoped, and the technique's real action already
# is a read.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=bridgelab-sensitive-data
